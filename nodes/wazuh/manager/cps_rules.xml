<!--
  cps_rules.xml — what the SOC's manager makes of the events the lab hosts ship.

  The hosts ship JSON lines: the DPI sensor's telemetry (kind ot_finding,
  ot_alert, ot_response_write) and the outcome of every active response
  (kind cps_response, written by cps_response.py). The rules turn each into an
  alert; deciding what to do about one is not the manager's job here.

  Installed as /var/ossec/etc/rules/cps_rules.xml by wazuh-manager-setup.sh.
-->
<group name="cps,">
  <rule id="100100" level="10">
    <decoded_as>json</decoded_as>
    <field name="kind">^ot_finding$</field>
    <description>CPS sensor finding: $(klass)</description>
  </rule>

  <rule id="100101" level="7">
    <decoded_as>json</decoded_as>
    <field name="kind">^ot_alert$</field>
    <description>CPS sensor alert $(state): $(klass)</description>
  </rule>

  <rule id="100110" level="3">
    <decoded_as>json</decoded_as>
    <field name="kind">^ot_response_write$</field>
    <description>CPS response write seen on the OT link, register $(register)</description>
  </rule>

  <rule id="100120" level="5">
    <decoded_as>json</decoded_as>
    <field name="kind">^cps_response$</field>
    <description>CPS countermeasure $(id) $(action) on this host</description>
  </rule>
</group>
